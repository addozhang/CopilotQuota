<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Pure-renderer widget: read-only access to the host app's shared
	     preference domain (sanitized snapshots & account metadata only;
	     zero network access and zero Keychain access). -->
	<key>com.apple.security.temporary-exception.shared-preference.read-only</key>
	<array>
		<string>app.solocraft.quotaring</string>
	</array>
</dict>
</plist>
